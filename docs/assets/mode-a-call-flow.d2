vars: {
  d2-config: {
    theme-id: 100
    layout-engine: elk
  }
}
direction: right

title: "Mode A, one real run: the Witness conducts call 06\nClaim A-4471-08 · same rep, badge 2210, 49 days apart · lines are from the automated test run" {
  near: top-center
  shape: text
  style.font-size: 22
  style.bold: true
}

s1: "1 · Disclosure\n\"AI assistant.\nThis call is recorded.\nName and badge?\"" { shape: circle }
s2: "2 · Verify claim\n\"What is the status\nof the claim?\"" { shape: circle }
flag1: "3 · CHALLENGE\nvalue conflict, same badge\n\"July eighth you said no\nprior auth. Which is it?\"" {
  shape: diamond
  style.stroke-width: 3
}
s4: "4 · Probe prior call\n\"Aug fifth, T. Okafor\nrecorded reprocessed.\nConfirm?\"" { shape: circle }
flag2: "5 · CHALLENGE\nexistence denial\n\"Our record shows that\ncall. Look it up?\"" {
  shape: diamond
  style.stroke-width: 3
}
s6: "6 · Refusal chain\nremit reason, diagnosis\ncode, remark code" { shape: circle }
s7: "7 · Reference + read-back\n\"Let me read that back:\n...nine eight eight. Correct?\"" { shape: circle }
s8: "8 · Gate clear\nrecap spoken,\nsession ends" {
  shape: oval
  style.stroke-width: 3
}

s1 -> s2: "\"Darnell, badge two-two-one-zero.\"" {
  style.font-size: 12
}
s2 -> flag1: "\"That claim denied. Timely filing.\"" {
  style.font-size: 12
}
flag1 -> s4: "\"I'm showing timely filing today.\"" {
  style.font-size: 12
}
s4 -> flag2: "\"I don't have a record\nof a call on August fifth.\"" {
  style.font-size: 12
}
flag2 -> s6: "\"I'd have to look into that.\"" {
  style.font-size: 12
}
s6 -> s7: "\"A diagnosis issue. Doesn't specify.\nRefer to the denial letter.\"" {
  style.font-size: 12
}
s7 -> s8: "\"Eight-K-two-J, nine-eight-eight.\"\n(unconfirmed) -> \"That's correct.\"" {
  style.font-size: 12
}
