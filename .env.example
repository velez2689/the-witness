# Copy to .env and fill in. .env is gitignored; never commit real values.

# AssemblyAI API key. Server-side only, read in src/app/api/token/ and nowhere else.
# The browser receives a short-lived, single-use token instead. Live path only.
ASSEMBLYAI_API_KEY=

# Hard ceiling on any single session, in seconds (60 to 600). Enforced in the minted token.
# Billing is on socket-open duration, so every session must be able to kill itself.
SESSION_MAX_SECONDS=300
