# Copy to .env and fill in. .env is gitignored - never commit real values.

# AssemblyAI API key. Server-side only. Never expose to the browser.
# The browser receives a short-lived token from /api/token instead.
ASSEMBLYAI_API_KEY=

# LLM pinned explicitly. Do not rely on default resolution.
ASSEMBLYAI_AGENT_LLM=qwen3.5-4b-fast

# Speech model pinned explicitly.
ASSEMBLYAI_STT_MODEL=universal-3-5-pro

# Hard ceiling on any single session, in seconds. Billing is on socket-open
# duration, so every session must be able to kill itself.
SESSION_MAX_SECONDS=900

# Voice for demo corpus rendering (fixtures/scripts/render-corpus.mjs). Server/dev only.
ELEVENLABS_API_KEY=
